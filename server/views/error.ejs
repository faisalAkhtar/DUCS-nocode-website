<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= message %></title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins&family=Urbanist&display=swap">
	<style>
		*{margin:0;box-sizing:border-box}
		html,body{height:100%}
		body{font-size:18px;font-family:Poppins,-apple-system,BlinkMacSystemFont,Roboto,Ubuntu;padding:min(10vw,10vh);display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:flex-start;overflow:hidden;background-color:#800080;color:#ff8000;background:radial-gradient(circle at 0% 85%,#800080,#800080 50%,#870587 75%,#800080 75%)}
	</style>
</head>

<body>
	<div id="app">
		<h1><%= message %></h1>
		<h2><%= error.status %></h2>
	</div>

	<script>console.log(`<%= error.stack %>`)</script>
</body>

</html>